{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": ""
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "TODO_ID_DE_APP_STORE_CONNECT",
        "appleTeamId": "TODO_TEAM_ID"
      }
    }
  }
}
