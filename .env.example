# Copia este archivo a ".env" y rellena tus valores.
# Las variables EXPO_PUBLIC_* las lee la app automáticamente.
# El archivo ".env" está en .gitignore: NUNCA subas tus claves reales.

# --- Cuentas con login (Supabase) ---
# Si están vacías, la app usa un mock local (desarrollo en Expo Go).
# En cuanto las rellenes, la app usa Supabase real sin tocar código.
# Las encuentras en tu panel de Supabase: Project Settings > API.
# La "anon key" es PÚBLICA por diseño (no es secreta): la seguridad la dan
# las Row Level Security policies del proyecto.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend de análisis de imágenes (Fase 2) ---
EXPO_PUBLIC_BACKEND_URL=
