{
  "expo": {
    "name": "Guau",
    "slug": "willys-core",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "guau",
    "userInterfaceStyle": "light",
    "primaryColor": "#1FA47C",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.willyapp.willy",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "NSCameraUsageDescription": "Usamos la cámara para hacer las fotos de tu perro o de la etiqueta de su comida que tú decidas analizar.",
        "NSPhotoLibraryUsageDescription": "Te permitimos elegir una foto de tu galería para analizarla."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E2F4EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1FA47C",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para hacer las fotos de tu perro o de la etiqueta de su comida que tú decidas analizar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Te permitimos elegir una foto de tu galería para analizarla."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
