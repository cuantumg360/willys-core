# Copia este archivo a ".env" y rellena tus valores.
# Las variables EXPO_PUBLIC_* las lee la app automáticamente.
# El archivo ".env" está en .gitignore: NUNCA subas tus claves reales.

# --- Cuentas con login (Supabase) ---
# Si están vacías, la app usa un mock local (desarrollo en Expo Go).
# En cuanto las rellenes, la app usa Supabase real sin tocar código.
# La "anon key" es PÚBLICA por diseño (no es secreta): la seguridad la dan
# las Row Level Security policies del proyecto.
# Proyecto "guau v1". La anon key la copias del panel: Project Settings > API
# (apartado "Claves API" → "anon public").
EXPO_PUBLIC_SUPABASE_URL=https://jnyowsltrjsqkidgcgol.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Pagos (RevenueCat) ---
# Claves PÚBLICAS de cliente (una por plataforma), del dashboard de
# RevenueCat: Project > API Keys. Solo se usan si activas el flag
# `useRealPurchases` en src/config/flags.ts y en un development build
# (RevenueCat NO funciona en Expo Go).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Backend de análisis de imágenes (IA real) ---
# Endpoint de la Edge Function "analyze" del proyecto "guau v1".
# El cliente le añade "/analyze" automáticamente. En cuanto esta variable
# está presente, la app usa la IA real (también en Expo Go).
EXPO_PUBLIC_BACKEND_URL=https://jnyowsltrjsqkidgcgol.supabase.co/functions/v1
